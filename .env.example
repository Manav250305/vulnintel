# Copy to .env and fill in if you need it. Nothing here is required for a
# normal run: vulnerability data comes from the fkie-cad release archives,
# which need no credentials.
#
# Only set this if you add a direct NVD API integration. A free key raises
# the NVD rate limit from 5 to 50 requests per 30 seconds.
# Request one at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_api_key_here
